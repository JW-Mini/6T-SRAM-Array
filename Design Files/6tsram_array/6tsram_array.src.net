*.EQUATION
*.SCALE METER
*.MEGA
.PARAM



************************************************************************
* Library Name: CE391Lab1
* Cell Name:    6tsram
* View Name:    schematic
************************************************************************

.SUBCKT 6tsram bl bl_b gnd vdd wl
*.PININFO wl:I bl:B bl_b:B gnd:B vdd:B
MM3 bl_b wl net9 gnd NMOS_VTG W=90n L=50n m=1
MM2 bl wl net6 gnd NMOS_VTG W=90n L=50n m=1
MM1 net9 net6 gnd gnd NMOS_VTG W=135.00n L=50n m=1
MM0 net6 net9 gnd gnd NMOS_VTG W=135.00n L=50n m=1
MM5 net9 net6 vdd vdd PMOS_VTG W=90n L=50n m=1
MM4 net6 net9 vdd vdd PMOS_VTG W=90n L=50n m=1
.ENDS

************************************************************************
* Library Name: CE391Lab1
* Cell Name:    6tsram_precharge
* View Name:    schematic
************************************************************************

.SUBCKT 6tsram_precharge bl bl_b preC vdd
*.PININFO preC:I bl:O bl_b:O vdd:B
MM2 bl preC bl_b vdd PMOS_VTG W=90n L=50n m=1
MM1 bl_b preC vdd vdd PMOS_VTG W=90n L=50n m=1
MM0 bl preC vdd vdd PMOS_VTG W=90n L=50n m=1
.ENDS

************************************************************************
* Library Name: CE391Lab1
* Cell Name:    6tsram_writecircuit
* View Name:    schematic
************************************************************************

.SUBCKT 6tsram_writecircuit bl bl_b data gnd vdd write
*.PININFO data:I write:I bl:B bl_b:B gnd:B vdd:B
MM4 net18 data gnd gnd NMOS_VTG W=90n L=50n m=1
MM3 net20 net18 gnd gnd NMOS_VTG W=180.0n L=50n m=1
MM2 bl write net20 gnd NMOS_VTG W=180.0n L=50n m=1
MM1 net19 data gnd gnd NMOS_VTG W=180.0n L=50n m=1
MM0 bl_b write net19 gnd NMOS_VTG W=180.0n L=50n m=1
MM5 net18 data vdd vdd PMOS_VTG W=90n L=50n m=1
.ENDS

************************************************************************
* Library Name: CE391Lab1
* Cell Name:    6tsram_clockedsense
* View Name:    schematic
************************************************************************

.SUBCKT 6tsram_clockedsense bl bl_b gnd sense sense_b sense_clk vdd
*.PININFO sense_clk:I bl:B bl_b:B gnd:B sense:B sense_b:B vdd:B
MM4 net16 sense_clk gnd gnd NMOS_VTG W=90n L=50n m=1
MM3 sense_b sense net16 gnd NMOS_VTG W=90n L=50n m=1
MM0 sense sense_b net16 gnd NMOS_VTG W=90n L=50n m=1
MM6 sense_b sense_clk bl_b vdd PMOS_VTG W=90n L=50n m=1
MM5 sense sense_clk bl vdd PMOS_VTG W=90n L=50n m=1
MM2 sense_b sense vdd vdd PMOS_VTG W=90n L=50n m=1
MM1 sense sense_b vdd vdd PMOS_VTG W=90n L=50n m=1
.ENDS

